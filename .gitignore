node_modules/
backend/data/*.sqlite
backend/data/*.sqlite-*
backend/data/uploads/
.DS_Store
android/.gradle/
android/build/
android/app/build/
android/local.properties
# 密钥/凭据等敏感文件，禁止提交
.env
.env.*
*.keystore
*.jks
google-services.json
GoogleService-Info.plist
ios/DerivedData/
ios/Pods/
# 递归匹配，避免嵌套目录（如 xcuserdata 深处）的产物漏网。
ios/**/*.xcuserstate
harmony/.hvigor/
harmony/oh_modules/
harmony/**/build/
macos/build/
macos/**/*.app
# libsusheng.a/.h 由 windows/cmd/engineexport 经 cgo（-buildmode=c-archive）生成，
# 头部标注 "Code generated by cmd/cgo; DO NOT EDIT."，属构建产物，故忽略。
macos/libsusheng.a
macos/libsusheng.h
windows/**/*.exe
protocol/lexicon-cache/
# *.log 为全仓忽略；当前无任何被跟踪的 .log 文件（已核实），若日后需保留参考日志再用 ! 例外。
*.log

# 编辑器 / IDE / Python / 测试覆盖率等机器本地产物
.idea/
*.iml
venv/
__pycache__/
coverage/
