export const legalTitles: string[] = [
  '用户服务协议',
  '隐私政策',
  '儿童隐私保护指引',
  '已收集个人信息清单',
  '第三方信息共享清单'
]

const updated = '2026年10月6日'

export function legalBody(title: string): string {
  if (title === '用户服务协议') {
    return `生效日期：${updated}\n\n欢迎使用苏晟输入法。本协议由苏晟集团与使用本应用的员工、合作达人订立。安装、登录或点击同意，即表示你已阅读并接受本协议和《隐私政策》。\n\n一、服务内容\n苏晟输入法提供本机中文输入，以及公司统一发布的话术、推文、宣发、词条和图片。键盘皮肤保存在这台设备上。\n\n二、账号\n登录使用的是公司内容台账号。请使用本人账号。账号权限由公司后台按部门和达人组分配。\n\n三、使用规范\n请按公司内容规范使用话术和图片。不要用本输入法发布违法信息，不要把未公开的内部资料粘贴到外部应用。\n\n四、输入内容\n你敲下的拼音和文字只在本机完成组词，不作为聊天记录上传。公司词库和热词由后台发布后同步到本机。\n\n五、皮肤\n应用内提供的键盘皮肤供内部使用，点按即可启用。皮肤选择保存在本机。\n\n六、协议更新\n协议更新后，会在应用内展示。你继续使用，即表示接受更新后的文本。若不同意，请停止使用并退出应用。`
  }
  if (title === '隐私政策') {
    return `生效日期：${updated}\n\n苏晟输入法是苏晟集团面向员工和合作达人的内部输入工具。我们按最小必要原则处理信息。\n\n一、不上传的内容\n你正在输入的拼音、候选词和已经上屏的句子，不会上传到内容台，也不会用于训练词库。\n\n二、我们处理的信息\n1. 账号和显示名：用于登录内容台，并在键盘里显示你的名字。\n2. 内容台地址：由你填写，用于连接公司服务器。\n3. 内容包：登录并同步后，本机保存公司发布的话术、推文、宣发、词条和图片。\n4. 使用记录：插入一条公司内容时，只上报该条目的编号和使用场景，不含你输入的文字。\n5. 本机偏好：当前皮肤只存在这台设备上。\n\n三、你的选择\n首次打开应用时，你可以阅读本政策后同意并进入首页，也可以拒绝并退出应用。拒绝后，若你已在系统里启用键盘，键盘仍可在本机打字，同样不会上传你敲下的字。`
  }
  if (title === '儿童隐私保护指引') {
    return `生效日期：${updated}\n\n苏晟输入法面向苏晟集团员工和合作达人，不向儿童提供账号、内容同步或个性化皮肤服务。\n\n我们不会主动收集儿童个人信息。如果你发现有儿童使用了公司账号，请联系内容管理员停用该账号。\n\n键盘在本机打字，不因使用者的年龄上传键入内容。`
  }
  if (title === '已收集个人信息清单') {
    return `生效日期：${updated}\n\n账号：你登录时填写，用于连接内容台。\n显示名：登录成功后由内容台返回。\n内容台地址：你填写，只用于发起同步。\n话术使用记录：条目编号和使用场景。不含拼音和上屏文字。\n键盘偏好：皮肤。只存在本机。\n同步下来的公司内容：话术、推文、宣发、词条和图片。\n\n不会收集：通讯录、定位、短信、通话记录、你敲下的原文。`
  }
  if (title === '第三方信息共享清单') {
    return `生效日期：${updated}\n\n苏晟输入法只在完成对应功能时把信息交给下列对象。\n\n公司内容台\n场景：登录、同步内容包、上报话术使用记录。\n内容：账号凭证、内容包、条目编号和使用场景。\n不会发送：你敲下的拼音和上屏文字。\n\n鸿蒙系统\n场景：启用输入法、切换默认输入法。\n内容：由系统在本机处理。\n\n除上述情形和法律法规要求外，我们不向其他第三方提供你的个人信息。`
  }
  // 未识别的标题绝不静默套用某一份文书，否则会展示错误的法律条款；返回明确的错误提示。
  return `无法加载《${title}》：未识别的法律文书标题。`
}
